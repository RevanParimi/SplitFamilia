# The upload key for SplitFamilia's release build (SF-013, docs/google-play/BUILD_RELEASE.md).
#
# Copy this file to android/keystore.properties (git-ignored) and replace the placeholders.
# Never commit the real file, the keystore or the passwords. Keep the keystore outside this
# repository and the passwords in a password manager.
#
# Use forward slashes in the path (a backslash is an escape character in this file).
# A relative path is read from the android/ folder.
# keytool's default (PKCS12) keystores use one password, so both passwords are usually the same.
storeFile=<FULL_PATH_TO>/splitfamilia-upload.jks
storePassword=<UPLOAD_KEYSTORE_PASSWORD>
keyAlias=upload
keyPassword=<UPLOAD_KEY_PASSWORD>
